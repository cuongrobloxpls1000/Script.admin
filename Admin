local Players = game:GetService("Players")
local player = Players.LocalPlayer

---------------- UI ----------------
local gui = Instance.new("ScreenGui")
gui.Parent = player.PlayerGui

-- Nút đỏ
local openBtn = Instance.new("TextButton")
openBtn.Parent = gui
openBtn.Size = UDim2.new(0,60,0,60)
openBtn.Position = UDim2.new(0,20,0.5,0)
openBtn.Text = "ADMIN"
openBtn.BackgroundColor3 = Color3.fromRGB(255,0,0)
openBtn.Active = true
openBtn.Draggable = true

-- Khung
local frame = Instance.new("Frame")
frame.Parent = gui
frame.Size = UDim2.new(0,300,0,350)
frame.Position = UDim2.new(0.5,-150,0.5,-175)
frame.Visible = false

-- Tiêu đề
local title = Instance.new("TextLabel")
title.Parent = frame
title.Size = UDim2.new(1,0,0,40)
title.Text = "Quyền admin"

-- Nút X
local closeBtn = Instance.new("TextButton")
closeBtn.Parent = frame
closeBtn.Size = UDim2.new(0,40,0,40)
closeBtn.Position = UDim2.new(1,-40,0,0)
closeBtn.Text = "X"

---------------- MỞ / ĐÓNG ----------------
openBtn.MouseButton1Click:Connect(function()
	frame.Visible = true
end)

closeBtn.MouseButton1Click:Connect(function()
	frame.Visible = false
end)

---------------- PHẦN 1 TELEPORT ----------------
local selectedPlayer=nil

local chooseBtn = Instance.new("TextButton")
chooseBtn.Parent = frame
chooseBtn.Size = UDim2.new(0,250,0,40)
chooseBtn.Position = UDim2.new(0,20,0,50)
chooseBtn.Text = "Chọn người chơi"

local listFrame = Instance.new("ScrollingFrame")
listFrame.Parent = frame
listFrame.Size = UDim2.new(0,250,0,100)
listFrame.Position = UDim2.new(0,20,0,90)
listFrame.Visible = false

chooseBtn.MouseButton1Click:Connect(function()
	listFrame.Visible = not listFrame.Visible
	
	listFrame:ClearAllChildren()

	local y=0

	for _,plr in pairs(Players:GetPlayers()) do

		local btn = Instance.new("TextButton")
		btn.Parent = listFrame
		btn.Size = UDim2.new(1,0,0,30)
		btn.Position = UDim2.new(0,0,0,y)
		btn.Text = plr.Name
		
		y=y+30

		btn.MouseButton1Click:Connect(function()
			selectedPlayer=plr
			listFrame.Visible=false
		end)

	end
end)

local tpBtn = Instance.new("TextButton")
tpBtn.Parent = frame
tpBtn.Size = UDim2.new(0,250,0,40)
tpBtn.Position = UDim2.new(0,20,0,200)
tpBtn.Text = "Xác nhận"

tpBtn.MouseButton1Click:Connect(function()

	if selectedPlayer and selectedPlayer.Character then
		
		player.Character.HumanoidRootPart.CFrame=
		selectedPlayer.Character.HumanoidRootPart.CFrame

	end

end)

---------------- PHẦN 2 JUMP ----------------
local jumpOn=false

local jumpBtn = Instance.new("TextButton")
jumpBtn.Parent = frame
jumpBtn.Size = UDim2.new(0,250,0,40)
jumpBtn.Position = UDim2.new(0,20,0,250)
jumpBtn.Text = "Vô hạn Jump OFF"

jumpBtn.MouseButton1Click:Connect(function()

	jumpOn=not jumpOn

	if jumpOn then
		player.Character.Humanoid.JumpPower=999
		jumpBtn.Text="Vô hạn Jump ON"
	else
		player.Character.Humanoid.JumpPower=50
		jumpBtn.Text="Vô hạn Jump OFF"
	end

end)

---------------- PHẦN 3 SPEED ----------------
local speedOn=false

local speedBtn = Instance.new("TextButton")
speedBtn.Parent = frame
speedBtn.Size = UDim2.new(0,250,0,40)
speedBtn.Position = UDim2.new(0,20,0,300)
speedBtn.Text = "+100 Speed OFF"

speedBtn.MouseButton1Click:Connect(function()

	speedOn=not speedOn

	if speedOn then
		player.Character.Humanoid.WalkSpeed=116
		speedBtn.Text="+100 Speed ON"
	else
		player.Character.Humanoid.WalkSpeed=16
		speedBtn.Text="+100 Speed OFF"
	end

end)

---------------- PHẦN 4 KILL ALL ----------------
local killOn=false

local killBtn = Instance.new("TextButton")
killBtn.Parent = frame
killBtn.Size = UDim2.new(0,250,0,40)
killBtn.Position = UDim2.new(0,20,0,350)
killBtn.Text = "Kill All OFF"

killBtn.MouseButton1Click:Connect(function()

	killOn=not killOn

	if killOn then
		killBtn.Text="Kill All ON"
	else
		killBtn.Text="Kill All OFF"
	end

end)

player.Character.HumanoidRootPart.Touched:Connect(function(hit)

	if killOn then

		local hum = hit.Parent:FindFirstChild("Humanoid")

		if hum then
			hum.Health=0
		end

	end

end)
